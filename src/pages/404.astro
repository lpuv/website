---
import Base from '../layouts/Base.astro';
---

<Base title="404 · Luna Puvilland" description="This room doesn't exist.">
  <div class="wrap lost">
    <div class="lost__room" aria-hidden="true">
      <svg class="lost__stump" viewBox="0 0 16 8" shape-rendering="crispEdges">
        <rect x="4" y="2" width="8" height="5" fill="#3a2428" />
        <rect x="4" y="2" width="8" height="1" fill="#5b3a3a" />
        <rect x="2" y="6" width="12" height="2" fill="#1c1216" />
        <rect x="11" y="3" width="1" height="4" fill="#1c1216" />
      </svg>
    </div>
    <h1 class="area__title">404</h1>
    <p class="lost__text">* (There used to be a tree here. Nobody is standing behind it.)</p>
    <div class="actions" style="justify-content:center">
      <a class="btn btn--primary" href="/"><span class="soul" aria-hidden="true"></span>Back to the tree</a>
      <a class="btn" href="/systems/">The work</a>
    </div>
  </div>
</Base>
