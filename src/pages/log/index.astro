---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('log'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-CA', { timeZone: 'UTC', year: 'numeric', month: 'short', day: '2-digit' }).format(d);
---

<Base title="Notes · Luna Puvilland" description="Writeups on infrastructure, security, and things that broke.">
  <div class="wrap area">
    <p class="area__kicker">you leave the tree behind ›</p>
    <h1 class="area__title">Notes</h1>
    <p class="area__sub">
      Writeups and post-mortems. Mostly infrastructure and security decisions I made and then had
      to live with.
    </p>
  </div>
  <div class="wrap">
    {posts.length === 0 ? (
      <p class="dim">* (There's nothing written here yet.)</p>
    ) : (
      <ul class="signs">
        {posts.map((p) => (
          <li>
            <a class="sign box" href={`/log/${p.id}/`}>
              <span class="sign__date">{fmt(p.data.date)}</span>
              <span class="sign__title">{p.data.title}</span>
              <span class="sign__desc">{p.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
