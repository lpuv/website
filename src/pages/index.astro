---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const allSystems = (await getCollection('systems')).sort((a, b) => a.data.order - b.data.order);

/** The map shows the machines that actually relate to each other. */
const bySlug = Object.fromEntries(allSystems.map((s) => [s.id, s]));
const map = [
  { id: 'core', label: 'pinwheel', kind: 'the machine', r: 9, w: 2.6,
    desc: 'One Proxmox host. Twelve NixOS containers on top of it. Everything else here runs on this.' },
  { id: 'nix-lab', r: 6, w: 1 },
  { id: 'rocket-cdh', r: 6, w: 1 },
  { id: 'fedora', r: 6, w: 1 },
  { id: 'cve-2012-2982', r: 6, w: 1 },
  { id: 'evil-tetris', r: 6, w: 1 },
].map((n) => {
  if (n.id === 'core') return n;
  const entry = bySlug[n.id];
  return {
    ...n,
    label: entry?.data.title ?? n.id,
    kind: entry?.data.designation ?? 'record',
    desc: entry?.data.summary ?? '',
  };
});

const links = [
  ['core', 'nix-lab'], ['core', 'rocket-cdh'], ['core', 'fedora'],
  ['core', 'cve-2012-2982'], ['core', 'evil-tetris'],
  ['nix-lab', 'fedora'], ['nix-lab', 'cve-2012-2982'],
  ['rocket-cdh', 'cve-2012-2982'], ['evil-tetris', 'cve-2012-2982'],
];

const featured = allSystems.filter((s) => s.data.featured);
const list = (featured.length ? featured : allSystems).slice(0, 6);
---

<Base title="Luna Puvilland — craftcat.dev">
  <section class="hero">
    <div class="wrap hero__wrap">
      <p class="hero__kicker">
        <span class="dot" aria-hidden="true"></span>
        Open to internships · Montréal
      </p>

      <h1 class="hero__name">I build systems that have to <em>keep running.</em></h1>

      <p class="hero__lede">
        Satellite firmware, a homelab rebuilt from one flake, Fedora packages in
        official repos. And I take old software apart to see how it breaks.
      </p>

      <ul class="actions hero__actions">
        <li><a class="btn btn--primary" href="#work">See the work <span class="btn__arrow" aria-hidden="true">→</span></a></li>
        <li><a class="btn" href="/resume">Resume</a></li>
        <li><a class="btn" href="/contact">Get in touch</a></li>
      </ul>

      <p class="hero__more">Grab a machine and pull</p>
    </div>

    <div class="hero__stage">
      <div class="depth" role="group" aria-label="Map depth">
        <button id="depth-map" type="button" aria-pressed="true">map</button>
        <button id="depth-run" type="button" aria-pressed="false">the tank</button>
      </div>

      <div class="tankhead" id="tankhead" hidden>
        <span class="tankhead__k">the tank</span>
        <h2 class="tankhead__t">Twelve VMs, no patches</h2>
        <p class="tankhead__d">They run whatever arrives by email and share files with each other. A monitor wipes infected machines and rebuilds them at random. Watch the orange ones — those are the viruses.</p>
        <div class="legend">
          <span><i class="lg-clean"></i>clean</span>
          <span><i class="lg-inf"></i>infected</span>
          <span><i class="lg-wip"></i>wiped</span>
        </div>
      </div>

      <canvas
        id="map"
        class="hero__canvas"
        tabindex="0"
        role="application"
        aria-label="A live map of Luna's projects. Drag any machine to move it. Arrow keys cycle through machines."
        aria-describedby="map-help"
        data-nodes={JSON.stringify(map)}
        data-links={JSON.stringify(links)}></canvas>

      <div class="hero__hint">
        <div class="hero__hint-body" aria-live="polite">
          <span class="node-tip__kind" id="ro-kind">the machine</span>
          <span class="node-tip__label" id="ro-label">pinwheel</span>
          <span class="node-tip__desc" id="ro-desc">One Proxmox host. Twelve NixOS containers on top of it. Everything else here runs on this.</span>
        </div>
        <span class="node-tip__go" id="ro-hint">drag to move · “the tank” opens the network</span>
        <ul class="maplog" id="map-log" aria-live="polite"></ul>
      </div>

      <p id="map-help" class="sr-only">
        This is a map of the machines Luna runs. pinwheel is the Proxmox host at the centre;
        the projects connect to it and to each other. Every project is also listed below the map.
      </p>
      <ul class="sr-only">
        {map.filter((n) => n.id !== 'core').map((n) => (
          <li>{n.label} — {n.kind}: {n.desc}</li>
        ))}
      </ul>
    </div>

    <div class="hero__status">
      <div class="wrap hero__status-inner">
        <span class="stat" id="stat-hosts">{map.length - 1} projects on the map</span>
        <span class="stat" id="stat-debt">{map.length - 1} machines</span>
        <span class="spacer"></span>
        <span class="stat hide-sm">montréal <b id="clock">--:--:--</b></span>
        <a class="stat" href="mailto:luna@craftcat.dev">luna@craftcat.dev</a>
      </div>
    </div>
  </section>

  <section class="section section--flush" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section__head">
        <div>
          <h2 class="section__title" id="work-title">What I've built</h2>
          <p class="section__sub">Infrastructure, security, and the things I build for fun.</p>
        </div>
        <a class="section__note" href="/systems">All {allSystems.length} records →</a>
      </div>

      <div class="cards">
        {list.map((entry, i) => (
          <a class="card" href={`/systems/${entry.id}/`}>
            <span class="card__index">{String(i + 1).padStart(2, '0')}</span>
            <span class="card__title">{entry.data.title}</span>
            <span class="card__desc">{entry.data.summary}</span>
            <span class="card__go">{entry.data.status}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  import { initMap } from '../scripts/map';

  initMap();

  const clock = document.getElementById('clock');
  const tick = () => {
    if (!clock) return;
    clock.textContent = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Toronto',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    }).format(new Date());
  };
  tick();
  setInterval(tick, 1000);
</script>
