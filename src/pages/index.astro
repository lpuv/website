---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SavePoint from '../components/SavePoint.astro';

const systems = (await getCollection('systems')).sort((a, b) => a.data.order - b.data.order);
const featured = systems.filter((s) => s.data.featured);
const work = featured.length ? featured : systems.slice(0, 6);

const skills = [
  { name: 'Infrastructure', value: 'Linux, NixOS, Proxmox, Kubernetes, Ansible, OpenShift, Docker' },
  { name: 'Security', value: 'Pentesting, CTFs, vulnerability research, least-privilege design' },
  { name: 'Embedded', value: 'TMS570, FreeRTOS, JTAG, oscilloscopes, MATLAB/Simulink' },
  { name: 'Languages', value: 'C, C++, Python, JavaScript, Java, Swift' },
];

const posts = (await getCollection('log'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-CA', { timeZone: 'UTC', year: 'numeric', month: 'short', day: '2-digit' }).format(d);

---

<Base title="Luna Puvilland · craftcat.dev">
  <section class="room" aria-labelledby="room-title">
    <div class="wrap room__head">
      <p class="kicker">Computer engineering · McGill '29 · Open to internships</p>
      <h1 class="room__title" id="room-title">Luna Puvilland</h1>
      <p class="room__lede">
        I build systems that have to keep running: satellite firmware, a homelab rebuilt from one
        flake, packages in Fedora. And I take old and new software alike apart to see how it breaks.
      </p>
    </div>

    <div class="wrap">
      <div
        class="stage"
        data-stage
        tabindex="0"
        role="application"
        aria-label="A dark room with a red tree. Someone is standing behind it. Use WASD or arrow keys to walk, Z or Enter to check the tree. The path at the bottom leads to the work. Everything here is also written out below."
      >
        <canvas aria-hidden="true"></canvas>
        <p class="stage__hint" data-stage-hint aria-hidden="true"></p>

        <div class="dlg box" data-dlg hidden>
          <p class="dlg__text" data-dlg-text aria-hidden="true"></p>
          <p class="sr-only" data-dlg-live aria-live="polite"></p>
          <div class="dlg__choices" data-dlg-choices></div>
          <span class="dlg__next" data-dlg-next hidden aria-hidden="true">▼</span>
        </div>
      </div>

      <div class="room__bar">
        <p class="room__music">
          ♪ Egg Room · arranged and performed by Trevor Alan Gomes
        </p>
        <p class="room__controls" aria-hidden="true">
          <kbd>WASD</kbd> walk · <kbd>Z</kbd> check · <kbd>X</kbd> skip · or click around
        </p>
        <div class="actions">
          <button class="btn btn--primary" type="button" data-talk>
            <span class="soul" aria-hidden="true"></span>Check the tree
          </button>
          <a class="btn" href="#work">See the work</a>
          <a class="btn" href="/resume/">Resume</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="wrap">
      <h2 class="section__title" id="about-title"><span class="soul soul--static" aria-hidden="true"></span>About</h2>
      <div class="power reveal">
        <div class="power__head">
          <canvas class="power__portrait" width="12" height="12" data-portrait aria-hidden="true"></canvas>
          <div>
            <p class="power__name">Luna</p>
            <p class="power__class">Computer engineer · McGill '29</p>
          </div>
        </div>
        <div class="power__body">
          <div>
            <p class="power__label">Stats</p>
            <dl class="power__stats">
              <div><dt>Now</dt><dd>C&amp;DH lead, McGill Orbital CubeSat</dd></div>
              <div><dt>Since 2021</dt><dd>Packager &amp; infra volunteer, Fedora</dd></div>
              <div><dt>Based</dt><dd>Montréal (from Los Angeles)</dd></div>
              <div><dt>Seeking</dt><dd>Internships: infrastructure, security, embedded</dd></div>
            </dl>
          </div>
          <div>
            <p class="power__label">Skills</p>
            <ul class="power__skills">
              {skills.map((k) => (
                <li><b>{k.name}</b><span>{k.value}</span></li>
              ))}
            </ul>
          </div>
        </div>
        <p class="power__desc">
          Builds systems that have to stay up, and takes old ones apart to see how they fall over.
          Finishes the silly projects too.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section__head">
        <h2 class="section__title" id="work-title"><span class="soul soul--static" aria-hidden="true"></span>Work</h2>
        <a class="section__more" href="/systems/">All {systems.length} records ›</a>
      </div>

      <div class="menu box reveal" data-menu>
        <ul class="menu__list" role="list">
          {work.map((entry, i) => (
            <li>
              <a
                class="menu__item"
                href={`/systems/${entry.id}/`}
                data-menu-item={i}
                aria-describedby={`work-${entry.id}`}
              >
                <span class="soul" aria-hidden="true"></span>
                <span class="menu__name">{entry.data.title}</span>
                <span class="menu__kind">{entry.data.designation}</span>
              </a>
              <p class="menu__inline">{entry.data.summary}</p>
            </li>
          ))}
        </ul>
        <div class="menu__detail">
          {work.map((entry, i) => (
            <div class="detail" id={`work-${entry.id}`} data-menu-panel={i} hidden={i !== 0}>
              <p class="detail__kind">{entry.data.designation} · {entry.data.status}</p>
              <p class="detail__title">{entry.data.title}</p>
              <p class="detail__desc">{entry.data.summary}</p>
              <dl class="detail__spec">
                <div><dt>Role</dt><dd>{entry.data.role}</dd></div>
                <div><dt>When</dt><dd>{entry.data.period}</dd></div>
                <div><dt>Stack</dt><dd>{entry.data.stack.join(' · ')}</dd></div>
              </dl>
              <a class="detail__go" href={`/systems/${entry.id}/`} tabindex="-1">Read the record ›</a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="notes" aria-labelledby="notes-title">
    <div class="wrap">
      <div class="section__head">
        <h2 class="section__title" id="notes-title"><span class="soul soul--static" aria-hidden="true"></span>Notes</h2>
        <a class="section__more" href="/log/">All notes ›</a>
      </div>
      <ul class="signs">
        {posts.map((p) => (
          <li class="reveal">
            <a class="sign box" href={`/log/${p.id}/`}>
              <span class="sign__date">{fmt(p.data.date)}</span>
              <span class="sign__title">{p.data.title}</span>
              <span class="sign__desc">{p.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--save" id="save" aria-labelledby="save-title">
    <div class="wrap save">
      <button class="save__star" type="button" data-save aria-label="Use the save point: opens a message to Luna">
        <SavePoint size={56} />
      </button>
      <h2 class="section__title" id="save-title">Say hello</h2>
      <p class="save__line" data-save-line>
        Open to internships in infrastructure, security, and embedded. Email is the reliable one.
      </p>
      <div class="save__file box">
        <div class="save__row">
          <b>LUNA</b><span>Montréal</span><span data-clock>--:--</span>
        </div>
        <div class="save__actions">
          <a class="save__opt" href="mailto:luna@craftcat.dev"><span class="soul" aria-hidden="true"></span>Email</a>
          <a class="save__opt" href="https://github.com/lpuv"><span class="soul" aria-hidden="true"></span>GitHub</a>
          <a class="save__opt" href="https://www.linkedin.com/in/luna-puvilland-41252738b"><span class="soul" aria-hidden="true"></span>LinkedIn</a>
          <a class="save__opt" href="/contact/"><span class="soul" aria-hidden="true"></span>More</a>
        </div>
      </div>
      <p class="save__mail"><a href="mailto:luna@craftcat.dev">luna@craftcat.dev</a></p>
    </div>
  </section>
</Base>

<script>
  import { initRoom } from '../scripts/room';
  import { play } from '../scripts/sfx';

  initRoom();

  // Portrait in the About box: the same cat as the room.
  import { drawCat } from '../scripts/sprites';
  const portrait = document.querySelector<HTMLCanvasElement>('[data-portrait]');
  portrait?.getContext('2d')?.drawImage(drawCat()[0], 0, 0);

  // Work menu: hover or focus selects, arrows move.
  const items = [...document.querySelectorAll<HTMLAnchorElement>('[data-menu-item]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-menu-panel]')];
  let current = 0;
  const select = (i: number, sound = true) => {
    if (i === current && items[i].classList.contains('is-sel')) return;
    current = i;
    items.forEach((el, j) => el.classList.toggle('is-sel', j === i));
    panels.forEach((el, j) => (el.hidden = j !== i));
    if (sound) play('move');
  };
  items.forEach((el, i) => {
    el.addEventListener('pointerenter', () => select(i));
    el.addEventListener('focus', () => select(i));
    el.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowDown' ? 1 : e.key === 'ArrowUp' ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      items[(i + d + items.length) % items.length].focus();
    });
  });
  if (items.length) select(0, false);

  // Save point.
  const line = document.querySelector('[data-save-line]');
  document.querySelector('[data-save]')?.addEventListener('click', () => {
    play('save');
    if (line) line.textContent = '(Nothing was saved. An email would work better.)';
  });

  const clock = document.querySelector('[data-clock]');
  const tick = () => {
    if (clock)
      clock.textContent = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'America/Toronto', hour: '2-digit', minute: '2-digit', hour12: false,
      }).format(new Date());
  };
  tick();
  setInterval(tick, 15000);
</script>
