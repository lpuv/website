---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const systems = (await getCollection('systems')).sort((a, b) => a.data.order - b.data.order);
const statuses = [...new Set(systems.map((s) => s.data.status))];
---

<Base
  title="Work · Luna Puvilland"
  description="Infrastructure, security, embedded and personal projects by Luna Puvilland, with the reasoning behind each one."
>
  <div class="wrap area">
    <p class="area__kicker">Projects</p>
    <h1 class="area__title">The work</h1>
    <p class="area__sub">
      Infrastructure, security, embedded, and the things I build for fun. What each one is, what
      was hard, and what I'd do differently.
    </p>
    <div class="filters" role="group" aria-label="Filter by status">
      <button class="filter" type="button" data-filter="all" aria-pressed="true"><span class="soul" aria-hidden="true"></span>All</button>
      {statuses.map((s) => (
        <button class="filter" type="button" data-filter={s} aria-pressed="false"><span class="soul" aria-hidden="true"></span>{s}</button>
      ))}
    </div>
  </div>

  <div class="wrap">
    <ul class="records">
      {systems.map((e) => (
        <li data-status={e.data.status}>
          <a class="record-card box" href={`/systems/${e.id}/`}>
            <span class="record-card__top">
              <span>{e.data.designation}</span>
              <span class="status" data-status={e.data.status}>{e.data.status}</span>
            </span>
            <span class="record-card__title"><span class="soul" aria-hidden="true"></span>{e.data.title}</span>
            <span class="record-card__desc">{e.data.summary}</span>
            <span class="record-card__stack">{e.data.role} · {e.data.period}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="dim" id="filter-empty" hidden style="margin-top:1.5rem">* (Nothing here.)</p>
  </div>
</Base>

<script>
  import { play } from '../../scripts/sfx';
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('li[data-status]');
  const empty = document.getElementById('filter-empty');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      play('move');
      const v = b.dataset.filter ?? 'all';
      buttons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      let shown = 0;
      cards.forEach((c) => {
        const match = v === 'all' || c.dataset.status === v;
        c.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    }),
  );
</script>
