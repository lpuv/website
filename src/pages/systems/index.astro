---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SystemCard from '../../components/SystemCard.astro';

const systems = (await getCollection('systems')).sort((a, b) => a.data.order - b.data.order);
const statuses = [...new Set(systems.map((entry) => entry.data.status))];
---

<Base
  title="Systems — Luna Puvilland"
  description="Infrastructure, security, and software projects by Luna Puvilland, with the reasoning behind each one."
>
  <div class="wrap page-head">
    <h1 class="page-head__title">What I've built</h1>
    <p class="page-head__sub">
      Infrastructure, security, and the things I build for fun. What each thing is, what was hard,
      and what I'd do differently.
    </p>

    <div class="filter-bar" role="group" aria-label="Filter systems by status">
      <button class="filter-btn" type="button" data-filter="all" aria-pressed="true">All</button>
      {statuses.map((status) => (
        <button class="filter-btn" type="button" data-filter={status} aria-pressed="false">
          {status}
        </button>
      ))}
    </div>
  </div>

  <div class="wrap page-body">
    <div class="cards">
      {systems.map((entry, i) => (
        <SystemCard
          entry={entry}
          index={i}
          wide={i === systems.length - 1 && systems.length % 2 === 1}
        />
      ))}
    </div>
    <p class="mono faint" id="filter-empty" hidden style="margin-top: 1.5rem;">
      No records with that status.
    </p>
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-status]');
  const empty = document.getElementById('filter-empty');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const value = button.dataset.filter ?? 'all';
      buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));

      let shown = 0;
      cards.forEach((card) => {
        const match = value === 'all' || card.dataset.status === value;
        card.hidden = !match;
        if (match) shown += 1;
      });

      if (empty) empty.hidden = shown > 0;
    });
  });
</script>
