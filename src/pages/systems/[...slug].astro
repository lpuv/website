---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const systems = (await getCollection('systems')).sort((a, b) => a.data.order - b.data.order);
  return systems.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: systems[i - 1] ?? null, next: systems[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { title, designation, summary, role, period, status, stack, repo, live } = entry.data;
---

<Base title={`${title} · Luna Puvilland`} description={summary}>
  <div class="wrap area">
    <p class="area__kicker"><a href="/systems/" style="text-decoration:none">‹ the work</a> · {designation}</p>
    <h1 class="area__title">{title}</h1>
    <p class="area__sub">{summary}</p>
  </div>

  <div class="wrap record">
    <aside class="spec box" aria-label="Details">
      <p class="spec__title">Details</p>
      <dl>
        <div><dt>Role</dt><dd>{role}</dd></div>
        <div><dt>When</dt><dd>{period}</dd></div>
        <div><dt>Status</dt><dd class="status" data-status={status}>{status}</dd></div>
        <div><dt>Stack</dt><dd>{stack.join(' · ')}</dd></div>
      </dl>
      {(repo || live) && (
        <div class="spec__links">
          {repo && <a href={repo} rel="noopener noreferrer"><span class="soul" aria-hidden="true"></span>Source ↗</a>}
          {live && <a href={live} rel="noopener noreferrer"><span class="soul" aria-hidden="true"></span>Live ↗</a>}
        </div>
      )}
    </aside>

    <div>
      <article class="prose"><Content /></article>
      <nav class="pager" aria-label="More work">
        {prev ? (
          <a class="box" href={`/systems/${prev.id}/`}><small>‹ previous</small><b>{prev.data.title}</b></a>
        ) : <span></span>}
        {next && (
          <a class="box pager__next" href={`/systems/${next.id}/`}><small>next ›</small><b>{next.data.title}</b></a>
        )}
      </nav>
    </div>
  </div>
</Base>
