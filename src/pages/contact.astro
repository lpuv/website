---
import Base from '../layouts/Base.astro';

const gifts = ['Kindness', 'Mind', 'Ambition', 'Bravery', 'Voice'];

const channels = [
  {
    label: 'Email',
    value: 'luna@craftcat.dev',
    href: 'mailto:luna@craftcat.dev',
    note: 'Fastest way to reach me.',
  },
  {
    label: 'GitHub',
    value: 'github.com/lpuv',
    href: 'https://github.com/lpuv',
    note: 'Code and commit history.',
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/luna-puvilland-41252738b',
    href: 'https://www.linkedin.com/in/luna-puvilland-41252738b',
    note: 'The professional one.',
  },
  {
    label: 'TryHackMe',
    value: 'tryhackme.com/p/lunapuv',
    href: 'https://tryhackme.com/p/lunapuv',
    note: 'Labs, CTFs, and the challenges I wrote.',
  },
  {
    label: 'Resume',
    value: 'craftcat.dev/resume',
    href: '/resume',
    note: 'The formal record, printable.',
  },
  {
    label: 'Location',
    value: 'Montréal, QC',
    href: 'https://www.openstreetmap.org/relation/1102816',
    note: 'Eastern time. Usually replies within a day.',
  },
];
---
<Base
  title="Contact · Luna Puvilland"
  description="Get in touch with Luna Puvilland: email, GitHub, LinkedIn, TryHackMe, and resume."
>
  <div class="wrap area">
    <p class="area__kicker">Contact</p>
    <h1 class="area__title">Say hello</h1>
    <p class="area__sub">
      Open to internships and interesting infrastructure or security problems. Email is the
      reliable one: <a href="mailto:luna@craftcat.dev" style="color:var(--sel)">luna@craftcat.dev</a>
    </p>
  </div>

  <div class="wrap">
    <form class="naming box" id="compose" action="mailto:luna@craftcat.dev" method="post" enctype="text/plain">
      <p class="naming__title">Name the person writing.</p>
      <label class="field">
        <span>Name</span>
        <input name="name" type="text" autocomplete="name" required maxlength="80" placeholder="..." />
      </label>
      <label class="field">
        <span>Your email</span>
        <input name="email" type="email" autocomplete="email" required maxlength="120" placeholder="you@example.com" />
      </label>
      <div class="field">
        <label for="color">Your favorite color</label>
        <div class="swatch">
          <input id="color" name="color" type="color" value="#ff1f3d" />
          <output class="swatch__hex" for="color" data-hex>#FF1F3D</output>
        </div>
      </div>
      <fieldset class="field gifts">
        <legend>Your gift</legend>
        <div class="gifts__grid">
          {gifts.map((g, i) => (
            <label class="gift">
              <input type="radio" name="gift" value={g} required checked={i === 0} />
              <span class="soul" aria-hidden="true"></span>{g}
            </label>
          ))}
        </div>
      </fieldset>
      <label class="field">
        <span>Message</span>
        <textarea name="message" rows="6" required maxlength="4000" placeholder="what you're working on, or what you want to talk about"></textarea>
      </label>
      <div class="naming__foot">
        <button class="btn btn--primary" type="submit"><span class="soul" aria-hidden="true"></span>Send</button>
        <p class="naming__status" id="compose-status" aria-live="polite">(This opens your mail client. No backend, no tracking.)</p>
      </div>
    </form>

    <ul class="channels">
      {channels.map((c) => (
        <li>
          <a class="channel box" href={c.href} rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            <b><span class="soul" aria-hidden="true"></span>{c.label}</b>
            <span>{c.value}</span>
            <small>{c.note}</small>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <script>
    const form = document.querySelector<HTMLFormElement>('#compose');
    const status = document.getElementById('compose-status');

    const colorIn = document.querySelector<HTMLInputElement>('#color');
    const hex = document.querySelector('[data-hex]');
    colorIn?.addEventListener('input', () => {
      if (hex) hex.textContent = colorIn.value.toUpperCase();
    });

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);
      const field = (k: string) => String(data.get(k) ?? '').trim();
      const name = field('name');
      const email = field('email');
      const message = field('message');
      const color = field('color').toUpperCase();
      const gift = field('gift');

      const body = `${message}\n\n— ${name}\n${email}\n\nFavorite color: ${color}\nGift: ${gift}`;
      // encodeURIComponent, not URLSearchParams: mail clients show "+" literally.
      const href =
        'mailto:luna@craftcat.dev' +
        `?subject=${encodeURIComponent(`craftcat.dev · ${name}`)}` +
        `&body=${encodeURIComponent(body)}`;

      const link = document.createElement('a');
      link.href = href;
      link.rel = 'noopener noreferrer';
      link.click();

      if (status) {
        status.textContent = '(Your mail client should open. If nothing happens, write to luna@craftcat.dev.)';
      }
    });
  </script>
</Base>
