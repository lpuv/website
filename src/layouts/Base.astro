---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Optional small label shown in the footer, e.g. a section code. */
  code?: string;
}

const {
  title,
  description = 'Luna Puvilland — computer engineering undergrad at McGill. Infrastructure, security, and systems that have to stay up.',
  code = 'v2.0',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://craftcat.dev');
const nav = [
  { href: '/systems', label: 'Systems' },
  { href: '/log', label: 'Log' },
  { href: '/resume', label: 'Resume' },
  { href: '/tank', label: 'Network' },
  { href: '/contact', label: 'Contact' },
];
const here = Astro.url.pathname;
const isCurrent = (href: string) => here === href || here.startsWith(href + '/');
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#06080d" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="craftcat.dev" />
    <meta property="og:image" content={new URL('/og.png', Astro.site ?? 'https://craftcat.dev').href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Luna Puvilland — computer engineering at McGill, infrastructure and security."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site ?? 'https://craftcat.dev').href} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="wrap topbar__inner">
        <a class="brand" href="/" aria-label="craftcat.dev — home">
          <svg class="brand__mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M6 7.4V3.8l3.3 2.2h5.4L18 3.8v3.6a7.1 7.1 0 1 1-12 0Z"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linejoin="round"></path>
            <circle cx="12" cy="12.6" r="5.1" stroke="currentColor" stroke-width="0.8" opacity="0.3"></circle>
            <circle class="brand__pulse" cx="12" cy="12.6" r="2" fill="currentColor"></circle>
          </svg>
          <span>craftcat<span class="brand__slash">/</span><span class="brand__sub">dev</span></span>
        </a>

        <nav class="nav" aria-label="Primary">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>

        <span class="status-pill" aria-hidden="true">
          <span class="status-pill__dot"></span>
          online
        </span>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer__grid">
        <div class="footer__brand">
          <a class="brand" href="/">
            <svg class="brand__mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M6 7.4V3.8l3.3 2.2h5.4L18 3.8v3.6a7.1 7.1 0 1 1-12 0Z"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linejoin="round"></path>
              <circle cx="12" cy="12.6" r="2" fill="currentColor"></circle>
            </svg>
            <span>craftcat<span class="brand__slash">/</span><span class="brand__sub">dev</span></span>
          </a>
          <p class="footer__tag">
            Luna Puvilland. Computer engineering undergrad at McGill, infrastructure and security
            on the side. Montréal.
          </p>
        </div>

        <nav class="footer__col" aria-label="Site">
          <h2>Site</h2>
          <a href="/systems">Systems</a>
          <a href="/log">Log</a>
          <a href="/resume">Resume</a>
          <a href="/tank">Network</a>
          <a href="/contact">Contact</a>
        </nav>

        <nav class="footer__col" aria-label="Elsewhere">
          <h2>Elsewhere</h2>
          <a href="https://github.com/lpuv" rel="me">GitHub ↗</a>
          <a href="https://www.linkedin.com/in/luna-puvilland-41252738b" rel="me">LinkedIn ↗</a>
          <a href="https://tryhackme.com/p/lunapuv" rel="me">TryHackMe ↗</a>
          <a href="mailto:luna@craftcat.dev">Email ↗</a>
          <a href="https://github.com/lpuv?tab=repositories">Repositories ↗</a>
        </nav>

        <p class="footer__legal">
          <span>© {year} Luna Puvilland · Montréal, QC</span>
          <span>Built with Astro · no trackers · {code}</span>
        </p>
      </div>
    </footer>

    <script>
      // Reveal on scroll. Content is visible by default; this only animates it in.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reveals = document.querySelectorAll<HTMLElement>('.reveal');

      if (!reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-in'));
      }

      // Fail-safe: never leave content invisible if the observer never fires.
      window.setTimeout(() => {
        document.querySelectorAll<HTMLElement>('.reveal:not(.is-in)').forEach((el) => {
          el.classList.add('is-in');
        });
      }, 5000);

      // Card spotlight follows the pointer.
      document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
        card.addEventListener('pointermove', (event) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
          card.style.setProperty('--my', `${event.clientY - rect.top}px`);
        });
      });

      // Reading progress for long-form pages.
      const bar = document.querySelector<HTMLElement>('[data-read-progress]');
      if (bar) {
        const update = () => {
          const doc = document.documentElement;
          const max = doc.scrollHeight - doc.clientHeight;
          const pct = max > 0 ? Math.min(100, (doc.scrollTop / max) * 100) : 0;
          bar.style.width = `${pct}%`;
        };
        update();
        document.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
      }
    </script>
  </body>
</html>
