---
import '@fontsource/pixelify-sans/400.css';
import '@fontsource/pixelify-sans/600.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Luna Puvilland. Computer engineering at McGill. Infrastructure, security, and embedded systems that have to keep running.',
} = Astro.props;

const site = Astro.site ?? new URL('https://craftcat.dev');
const canonical = new URL(Astro.url.pathname, site);
const nav = [
  { href: '/systems/', label: 'Work' },
  { href: '/log/', label: 'Notes' },
  { href: '/resume/', label: 'Resume' },
  { href: '/contact/', label: 'Contact' },
];
const here = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => here === href || here.startsWith(href);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="craftcat.dev" />
    <meta property="og:image" content={new URL('/og.png', site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="wrap topbar__inner">
        <a class="brand" href="/" aria-label="craftcat.dev, home">
          <span class="soul soul--static" aria-hidden="true"></span>
          craftcat<span class="dim">.dev</span>
        </a>

        <nav class="nav" aria-label="Primary">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span class="soul" aria-hidden="true"></span>{item.label}
            </a>
          ))}
        </nav>

        <div class="tools">
          <div class="items">
            <button class="tool" type="button" data-items-btn aria-expanded="false" aria-controls="items-menu">
              ITEM<span class="items__count" data-items-count hidden></span>
            </button>
            <div class="items__menu box" id="items-menu" data-items-menu hidden>
              <p class="items__empty" data-items-empty>* (You have nothing.)</p>
              <ul data-items-list></ul>
            </div>
          </div>
          <button class="tool" type="button" data-sound aria-pressed="false" title="Sound">
            <span aria-hidden="true">♪</span> <span data-sound-label>off</span>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer__inner">
        <a class="bench" href="#main" data-bench>
          <svg viewBox="0 0 20 10" aria-hidden="true" shape-rendering="crispEdges">
            <rect x="1" y="2" width="18" height="2" fill="currentColor" />
            <rect x="1" y="5" width="18" height="1" fill="currentColor" />
            <rect x="3" y="6" width="1" height="4" fill="currentColor" />
            <rect x="16" y="6" width="1" height="4" fill="currentColor" />
            <rect x="2" y="0" width="1" height="2" fill="currentColor" />
            <rect x="17" y="0" width="1" height="2" fill="currentColor" />
          </svg>
          <span>Rest at the bench <span class="dim">(back to top)</span></span>
        </a>

        <nav class="footer__links" aria-label="Elsewhere">
          <a href="mailto:luna@craftcat.dev">Email</a>
          <a href="https://github.com/lpuv" rel="me">GitHub</a>
          <a href="https://www.linkedin.com/in/luna-puvilland-41252738b" rel="me">LinkedIn</a>
          <a href="https://tryhackme.com/p/lunapuv" rel="me">TryHackMe</a>
        </nav>

        <div class="footer__legal">
          <p>© {year} Luna Puvilland · Montréal · no trackers</p>
          <p class="dim">
            Music in the tree room: the Egg Room theme from DELTARUNE Chapter 5, a piano
            arrangement of Toby Fox’s “Scarlet Forest” by
            <a href="https://www.trevorgomes.com">Trevor Alan Gomes</a>, creator of the
            <a href="https://www.materiacollective.com/music/deltarune-piano-collections-volume-1"><cite>DELTARUNE Piano Collections</cite></a>.
          </p>
          <p class="dim">
            DELTARUNE and its characters, names, and music are © Toby Fox. This site is not affiliated with or endorsed by Toby Fox, Fangamer, or Materia
            Collective.
          </p>
        </div>
      </div>
    </footer>

    <script>
      import { isOn, setOn, play } from '../scripts/sfx';
      import { inventory } from '../scripts/dialogue';

      // Sound toggle
      const sb = document.querySelector<HTMLButtonElement>('[data-sound]');
      const sl = document.querySelector('[data-sound-label]');
      const syncSound = () => {
        const on = isOn();
        sb?.setAttribute('aria-pressed', String(on));
        document.documentElement.dataset.audio = on ? 'on' : 'off';
        if (sl) sl.textContent = on ? 'on' : 'off';
      };
      sb?.addEventListener('click', () => {
        setOn(!isOn());
        syncSound();
        play('select');
      });
      syncSound();

      // ITEM menu
      const ITEMS: Record<string, { name: string; desc: string; href: string; use: string }> = {
        egg: {
          name: 'EGG',
          desc: "It's an egg. It's also Luna's resume.",
          href: '/resume/',
          use: 'USE',
        },
      };
      const btn = document.querySelector<HTMLButtonElement>('[data-items-btn]');
      const menu = document.querySelector<HTMLElement>('[data-items-menu]');
      const list = document.querySelector<HTMLElement>('[data-items-list]');
      const empty = document.querySelector<HTMLElement>('[data-items-empty]');
      const count = document.querySelector<HTMLElement>('[data-items-count]');
      const renderItems = () => {
        const owned = inventory.get().filter((id) => ITEMS[id]);
        if (count) {
          count.hidden = owned.length === 0;
          count.textContent = String(owned.length);
        }
        if (empty) empty.hidden = owned.length > 0;
        if (!list) return;
        list.innerHTML = '';
        for (const id of owned) {
          const it = ITEMS[id];
          const li = document.createElement('li');
          li.innerHTML = `<a class="items__item" href="${it.href}"><span class="soul" aria-hidden="true"></span><b></b><span></span><em>${it.use}</em></a>`;
          li.querySelector('b')!.textContent = it.name;
          li.querySelector('span:not(.soul)')!.textContent = it.desc;
          list.append(li);
        }
      };
      const toggle = (open: boolean) => {
        if (!menu || !btn) return;
        menu.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        if (open) play('move');
      };
      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggle(menu?.hidden === true);
      });
      document.addEventListener('click', (e) => {
        if (menu && !menu.hidden && !menu.contains(e.target as Node)) toggle(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') toggle(false);
      });
      document.addEventListener('cc:items', () => {
        renderItems();
        btn?.classList.add('is-new');
        setTimeout(() => btn?.classList.remove('is-new'), 2400);
      });
      renderItems();

      // Bench: rest, then back to the top.
      document.querySelector('[data-bench]')?.addEventListener('click', () => play('save'));

      // Reveal-on-scroll, never leaving content hidden.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reveals = document.querySelectorAll<HTMLElement>('.reveal');
      if (!reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const en of entries) if (en.isIntersecting) {
            en.target.classList.add('is-in');
            io.unobserve(en.target);
          }
        }, { rootMargin: '0px 0px -8% 0px' });
        reveals.forEach((el) => io.observe(el));
        setTimeout(() => reveals.forEach((el) => el.classList.add('is-in')), 4000);
      } else reveals.forEach((el) => el.classList.add('is-in'));
    </script>
  </body>
</html>
