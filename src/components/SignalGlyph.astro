---
/**
 * A deterministic little constellation, one per project. Pure SVG, no JS.
 * It reads as a network signature rather than a generic icon.
 */
interface Props {
  seed: string;
  class?: string;
}

const { seed, class: className = '' } = Astro.props;

function hash(input: string): number {
  let h = 2166136261;
  for (let i = 0; i < input.length; i++) {
    h ^= input.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function mulberry32(a: number): () => number {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const random = mulberry32(hash(seed));
const points = Array.from({ length: 6 }, (_, i) => ({
  x: 7 + i * 17 + random() * 6,
  y: 8 + random() * 26,
}));

const edges: Array<[number, number]> = [
  [0, 1],
  [1, 2],
  [2, 3],
  [3, 4],
  [4, 5],
  [1, 4],
  [0, 3],
];

const heroIndex = 2 + Math.floor(random() * 3);
---

<svg
  class:list={['card__glyph', className]}
  viewBox="0 0 100 42"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {
    edges.map(([a, b]) => (
      <line
        x1={points[a].x}
        y1={points[a].y}
        x2={points[b].x}
        y2={points[b].y}
        stroke="currentColor"
        stroke-width="0.9"
        opacity="0.45"
      />
    ))
  }
  {
    points.map((point, index) => (
      <circle
        cx={point.x}
        cy={point.y}
        r={index === heroIndex ? 2.4 : 1.4}
        fill="currentColor"
        opacity={index === heroIndex ? 1 : 0.7}
      />
    ))
  }
</svg>
