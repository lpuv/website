---
import type { CollectionEntry } from 'astro:content';
import SignalGlyph from './SignalGlyph.astro';

interface Props {
  entry: CollectionEntry<'systems'>;
  index: number;
  wide?: boolean;
}

const { entry, index, wide = false } = Astro.props;
const { title, designation, summary, stack, status, role, period } = entry.data;
---

<a
  class:list={['card', 'reveal', { 'card--wide': wide }]}
  href={`/systems/${entry.id}/`}
  data-status={status}
  data-delay={String(Math.min(index, 3))}
>
  <div class="card__top">
    <span class="card__index">
      {String(index + 1).padStart(2, '0')} · {designation} · {status}
    </span>
    <SignalGlyph seed={entry.id} />
  </div>

  <h3 class="card__title">{title}</h3>
  <p class="card__desc">{summary}</p>

  <div class="card__foot">
    <div class="card__tags">
      {stack.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
    </div>
    <span class="card__go">Open record →</span>
  </div>

  <span class="sr-only">{role}, {period}</span>
</a>
