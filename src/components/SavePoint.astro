---
/** The glowing save star. Purely decorative; the parent decides what it does. */
interface Props { size?: number }
const { size = 40 } = Astro.props;
---
<svg class="savepoint" width={size} height={size} viewBox="0 0 11 11" aria-hidden="true" shape-rendering="crispEdges">
  <g fill="#ffd800">
    <rect x="5" y="0" width="1" height="2" />
    <rect x="4" y="2" width="3" height="2" />
    <rect x="0" y="4" width="11" height="1" />
    <rect x="1" y="5" width="9" height="1" />
    <rect x="2" y="6" width="7" height="1" />
    <rect x="3" y="7" width="5" height="1" />
    <rect x="2" y="8" width="3" height="1" /><rect x="6" y="8" width="3" height="1" />
    <rect x="1" y="9" width="2" height="1" /><rect x="8" y="9" width="2" height="1" />
    <rect x="0" y="10" width="1" height="1" /><rect x="10" y="10" width="1" height="1" />
  </g>
  <g fill="#fff6a8"><rect x="5" y="3" width="1" height="2" /><rect x="4" y="5" width="1" height="1" /></g>
</svg>
